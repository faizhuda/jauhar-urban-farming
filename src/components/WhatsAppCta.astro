---
import { waOrderLink } from '../config';
import WhatsAppIcon from './WhatsAppIcon.astro';

/**
 * CTA utama seluruh situs (PRD F3, §11.2):
 * full-width di mobile, target sentuh >=44px, membuka chat WA dengan pesan template.
 */
interface Props {
  /** Nama produk untuk template pesan; kosongkan untuk pesan umum. */
  productName?: string;
  label?: string;
  /** Gaya tombol mengikuti design system luxury. */
  variant?: 'primary' | 'secondary' | 'underline' | 'gold' | 'ghost-light';
  /** Ukuran lebih besar untuk hero/kontak. */
  size?: 'md' | 'lg';
}

const { productName, label = 'Order via WhatsApp', variant = 'primary', size = 'md' } = Astro.props;

const variantClasses = {
  primary: 'btn-primary',
  secondary: 'btn-secondary',
  underline: 'btn-underline',
  gold: 'btn-gold',
  'ghost-light': 'btn-ghost-light',
}[variant];

const sizeClasses = size === 'lg' || variant === 'underline' ? '' : 'px-6 py-3';
---

<a
  href={waOrderLink(productName)}
  target="_blank"
  rel="noopener noreferrer"
  class={`btn ${variantClasses} ${sizeClasses} w-full sm:w-auto`}
>
  <WhatsAppIcon class="h-4 w-4 shrink-0 fill-current" />
  {label}
</a>
