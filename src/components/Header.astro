---
import { Image } from 'astro:assets';
import { SITE, waOrderLink } from '../config';
import logo from '../assets/brand/logo.png';

const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  { href: '/products', label: 'Products' },
  { href: '/gallery', label: 'Gallery' },
  { href: '/journal', label: 'Journal' },
  { href: '/contact', label: 'Contact' },
];

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => currentPath === (href === '/' ? '/' : href);
---

<header class="sticky top-0 z-40 border-b border-outline-variant/30 bg-surface/80 backdrop-blur-md">
  <div class="shell flex h-20 items-center justify-between gap-4">
    <a href="/" class="flex min-h-11 shrink-0 items-center gap-3 font-serif text-lg font-bold tracking-tight text-primary sm:text-xl">
      <Image src={logo} alt="" width={44} height={44} loading="eager" class="h-9 w-9 sm:h-10 sm:w-10" />
      {SITE.name}
    </a>

    {/* Navigasi desktop */}
    <nav aria-label="Main" class="hidden lg:block">
      <ul class="flex items-center gap-8">
        {
          navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                aria-current={isActive(link.href) ? 'page' : undefined}
                class={`relative inline-flex min-h-11 items-center text-label-caps uppercase tracking-[0.16em] transition-colors duration-500 after:absolute after:bottom-2 after:left-0 after:h-px after:bg-accent after:transition-all after:duration-500 ${
                  isActive(link.href)
                    ? 'text-primary after:w-full'
                    : 'text-on-surface-variant after:w-0 hover:text-primary hover:after:w-full'
                }`}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <a
        href={waOrderLink()}
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-primary hidden px-6 py-3 lg:inline-flex"
      >
        Order via WhatsApp
      </a>

      {/* Tombol hamburger (mobile), target sentuh >=44px (PRD §11.2) */}
      <button
        id="menu-toggle"
        type="button"
        class="inline-flex min-h-11 min-w-11 cursor-pointer items-center justify-center text-primary hover:bg-surface-container lg:hidden touch-manipulation select-none"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Open menu"
      >
        <svg id="icon-open" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="pointer-events-none h-6 w-6" aria-hidden="true">
          <line x1="4" x2="20" y1="6" y2="6"></line>
          <line x1="4" x2="20" y1="12" y2="12"></line>
          <line x1="4" x2="20" y1="18" y2="18"></line>
        </svg>
        <svg id="icon-close" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="pointer-events-none hidden h-6 w-6" aria-hidden="true">
          <path d="M18 6 6 18"></path>
          <path d="m6 6 12 12"></path>
        </svg>
      </button>
    </div>
  </div>

  {/* Menu mobile */}
  {/* Latar dibiarkan transparan agar glassmorphism (bg-surface/80 + blur) milik
     <header> ikut membungkus panel ini — konsisten dengan bar atasnya. */}
  <nav id="mobile-menu" aria-label="Main mobile" class="hidden border-t border-outline-variant/30 px-6 pb-6 pt-2 lg:hidden">
    <ul class="flex flex-col">
      {
        navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              aria-current={isActive(link.href) ? 'page' : undefined}
              class={`flex min-h-11 items-center border-b border-outline-variant/20 py-3 text-label-caps uppercase ${
                isActive(link.href) ? 'text-primary' : 'text-on-surface-variant'
              }`}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
    <a
      href={waOrderLink()}
      target="_blank"
      rel="noopener noreferrer"
      class="btn btn-primary mt-4 w-full"
    >
      Order via WhatsApp
    </a>
  </nav>
</header>

<script is:inline>
  (function () {
    function initHeader() {
      var toggle = document.getElementById('menu-toggle');
      var menu = document.getElementById('mobile-menu');
      var iconOpen = document.getElementById('icon-open');
      var iconClose = document.getElementById('icon-close');

      if (!toggle || !menu) return;

      function setOpen(open) {
        if (open) {
          menu.classList.remove('hidden');
          if (iconOpen) iconOpen.classList.add('hidden');
          if (iconClose) iconClose.classList.remove('hidden');
          toggle.setAttribute('aria-expanded', 'true');
          toggle.setAttribute('aria-label', 'Close menu');
        } else {
          menu.classList.add('hidden');
          if (iconOpen) iconOpen.classList.remove('hidden');
          if (iconClose) iconClose.classList.add('hidden');
          toggle.setAttribute('aria-expanded', 'false');
          toggle.setAttribute('aria-label', 'Open menu');
        }
      }

      function handleToggle(e) {
        if (e) {
          e.preventDefault();
          e.stopPropagation();
        }
        var isHidden = menu.classList.contains('hidden');
        setOpen(isHidden);
      }

      toggle.onclick = handleToggle;

      var menuLinks = menu.querySelectorAll('a');
      for (var i = 0; i < menuLinks.length; i++) {
        menuLinks[i].addEventListener('click', function () {
          setOpen(false);
        });
      }

      document.addEventListener('click', function (event) {
        var target = event.target;
        if (!menu.classList.contains('hidden') && !menu.contains(target) && !toggle.contains(target)) {
          setOpen(false);
        }
      });

      document.addEventListener('keydown', function (event) {
        if (event.key === 'Escape') setOpen(false);
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initHeader);
    } else {
      initHeader();
    }
  })();
</script>
