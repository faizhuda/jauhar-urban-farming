---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import heroImage from '../../assets/gallery/morning-harvest.jpg';

const entries = (await getCollection('journal')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const dateFormatter = new Intl.DateTimeFormat('en-MY', { day: 'numeric', month: 'long', year: 'numeric' });
---

<BaseLayout
  title="The Harvest Journal"
  description="Stories, updates, and lessons from campus urban farming at Jauhar Urban Farming, IIUM Gombak."
>
  {/* Hero grande full-bleed, konsisten dengan Gallery/Contact */}
  <section class="relative flex min-h-[64svh] items-end overflow-hidden bg-primary md:min-h-[74svh]">
    <div class="absolute -inset-y-[6%] inset-x-0" data-parallax>
      <Image
        src={heroImage}
        alt=""
        width={1200}
        height={675}
        widths={[640, 1200, 1600]}
        sizes="100vw"
        quality={60}
        loading="eager"
        fetchpriority="high"
        class="h-full w-full object-cover"
      />
    </div>
    <div class="hero-scrim absolute inset-0"></div>
    <div class="shell relative z-10 pb-14 pt-32 md:pb-16 md:pt-40">
      <div class="max-w-3xl">
        <p class="kicker kicker-dark hero-enter mb-5">The Harvest Journal</p>
        <h1 class="hero-enter mb-6 font-serif text-display-sm text-on-primary md:text-display-lg">
          Stories from the field.
        </h1>
        <p class="hero-enter-delayed max-w-2xl text-body-lg text-on-primary/85">
          Updates, lessons, and behind-the-scenes notes from our fertigation beds
          at IIUM Gombak.
        </p>
      </div>
    </div>
  </section>

  <section class="shell py-16 md:py-24">
    {
      entries.length === 0 ? (
        <p class="text-body-md text-on-surface-variant">No stories yet, check back soon.</p>
      ) : (
        <ul class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
          {entries.map((entry, index) => (
            <li data-reveal style={`--reveal-delay: ${(index % 3) * 130}ms`}>
              <a
                href={`/journal/${entry.id}/`}
                class="card-luxe group flex h-full flex-col border border-outline-variant/40 bg-surface-container-lowest hover:border-accent/40"
              >
                <div class="overflow-hidden">
                  <Image
                    src={entry.data.image}
                    alt={entry.data.imageAlt}
                    width={640}
                    height={480}
                    widths={[320, 480, 640]}
                    sizes="(min-width: 1024px) 400px, (min-width: 640px) 45vw, 92vw"
                    loading="lazy"
                    class="img-luxe aspect-[4/3] w-full object-cover"
                  />
                </div>
                <div class="flex flex-1 flex-col gap-2 p-5">
                  <span class="text-label-caps uppercase text-on-surface-variant">
                    {dateFormatter.format(entry.data.date)}
                  </span>
                  <h2 class="font-serif text-xl text-primary">{entry.data.title}</h2>
                  <p class="text-body-md text-on-surface-variant">{entry.data.description}</p>
                </div>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </section>
</BaseLayout>
