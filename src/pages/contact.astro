---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import JsonLd from '../components/JsonLd.astro';
import WhatsAppCta from '../components/WhatsAppCta.astro';
import WhatsAppIcon from '../components/WhatsAppIcon.astro';
import { SITE, waOrderLink, mapsEmbedUrl, fullAddress, localBusinessLd } from '../config';
import heroImage from '../assets/gallery/drip-lines.jpg';

const businessLd = localBusinessLd(new URL(heroImage.src, Astro.site).href, Astro.site?.href);
---

<BaseLayout
  title="Contact"
  description="Find Jauhar Urban Farming at IIUM Gombak, Kuala Lumpur. Opening hours, WhatsApp ordering, social media, and directions to our campus farm."
>
  <JsonLd data={businessLd} />

  {/* Hero grande full-bleed */}
  <section class="relative flex min-h-[64svh] items-end overflow-hidden bg-primary md:min-h-[74svh]">
    <div class="absolute -inset-y-[6%] inset-x-0" data-parallax>
      <Image
        src={heroImage}
        alt=""
        width={1200}
        height={675}
        widths={[640, 1200, 1600]}
        sizes="100vw"
        quality={60}
        loading="eager"
        fetchpriority="high"
        class="h-full w-full object-cover"
      />
    </div>
    <div class="hero-scrim absolute inset-0"></div>
    <div class="shell relative z-10 pb-14 pt-32 md:pb-16 md:pt-40">
      <div class="max-w-2xl text-on-primary">
        <p class="kicker kicker-dark hero-enter mb-5">Visit &amp; connect</p>
        <h1 class="hero-enter mb-5 font-serif text-display-sm md:text-display-lg">Get in touch.</h1>
        <p class="hero-enter-delayed max-w-xl text-body-lg text-on-primary/85">
          The fastest way to reach us is WhatsApp, whether for orders, farm tours, or
          anything else.
        </p>
      </div>
    </div>
  </section>

  {/* Info + peta */}
  <section class="shell py-16 md:py-24">
    <div class="grid grid-cols-1 gap-12 md:grid-cols-12">
      <div class="space-y-10 md:col-span-5" data-reveal>
        {/* Lokasi */}
        <div>
          <h2 class="mb-6 inline-block border-b border-accent pb-2 text-label-caps uppercase tracking-[0.18em] text-primary">
            Where we are
          </h2>
          <p class="font-serif text-headline-md text-primary">Farm location</p>
          <address class="mt-4 max-w-xs text-body-md not-italic text-on-surface-variant">
            {fullAddress()}
          </address>
        </div>

        {/* Jam operasional */}
        <div>
          <h2 class="mb-6 inline-block border-b border-accent pb-2 text-label-caps uppercase tracking-[0.18em] text-primary">
            Opening hours
          </h2>
          <ul class="max-w-xs space-y-3 text-body-md text-on-surface-variant">
            <li class="flex justify-between gap-6 border-b border-outline-variant/30 pb-2">
              <span>Monday to Friday</span>
              <span>{SITE.hours.opens} - {SITE.hours.closes}</span>
            </li>
            <li class="flex justify-between gap-6 text-outline">
              <span>Saturday &amp; Sunday</span>
              <span>Closed</span>
            </li>
          </ul>
        </div>

        {/* Kontak langsung */}
        <div>
          <h2 class="mb-6 inline-block border-b border-accent pb-2 text-label-caps uppercase tracking-[0.18em] text-primary">
            Direct lines
          </h2>
          <div class="space-y-6">
            <a href={waOrderLink()} target="_blank" rel="noopener noreferrer" class="group flex items-center gap-4">
              <span class="flex h-12 w-12 shrink-0 items-center justify-center bg-accent-soft transition-colors duration-500 group-hover:bg-primary">
                <WhatsAppIcon class="h-5 w-5 fill-primary transition-colors duration-500 group-hover:fill-accent-bright" />
              </span>
              <span>
                <span class="block text-label-caps uppercase text-on-surface-variant">WhatsApp</span>
                <span class="block text-body-md font-bold text-primary">Chat with the farm</span>
              </span>
            </a>
            <a href={SITE.socials.instagram} target="_blank" rel="noopener noreferrer" class="group flex items-center gap-4">
              <span class="flex h-12 w-12 shrink-0 items-center justify-center bg-accent-soft transition-colors duration-500 group-hover:bg-primary">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5 text-primary transition-colors duration-500 group-hover:text-accent-bright" aria-hidden="true">
                  <rect width="20" height="20" x="2" y="2" rx="5" ry="5"></rect>
                  <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                  <line x1="17.5" x2="17.51" y1="6.5" y2="6.5"></line>
                </svg>
              </span>
              <span>
                <span class="block text-label-caps uppercase text-on-surface-variant">Instagram</span>
                <span class="block text-body-md font-bold text-primary">Follow the farm</span>
              </span>
            </a>
          </div>
          <div class="mt-10">
            <WhatsAppCta size="lg" label="Order via WhatsApp" />
          </div>
        </div>
      </div>

      {/* Peta: resource terberat halaman ini, dimuat lazy (PRD §10.3) */}
      <div class="md:col-span-7" data-reveal style="--reveal-delay: 150ms">
        <iframe
          src={mapsEmbedUrl()}
          title="Map showing the location of Jauhar Urban Farming at IIUM Gombak"
          loading="lazy"
          allowfullscreen
          referrerpolicy="no-referrer-when-downgrade"
          class="h-80 w-full border border-outline-variant/40 md:h-full md:min-h-[26rem]"
        ></iframe>
      </div>
    </div>
  </section>
</BaseLayout>
